{
  "name": "puzzlemind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin": "node server/admin-cli.js",
    "backup": "node server/backup-cli.js",
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:admin-browser": "node tests/admin-browser.mjs",
    "format": "prettier --write src server shared tests index.html vite.config.ts README.md"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.51.0",
    "prettier": "^3.9.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
