# Node 22.13 or newer is required for the built-in SQLite driver.
PORT=3001
DATA_DIR=./data
APP_URL=http://localhost:5173

# On Railway, attach a persistent volume at /data and set DATA_DIR=/data.
# Set RAILPACK_NODE_VERSION=22 and RAILPACK_NO_SPA=true when building on Railway.
# Set APP_URL to the generated https:// public origin, without a trailing slash.
# Set this only when the app is reachable through exactly one trusted proxy:
# TRUST_PROXY_HOPS=1

# Set both values for real password-reset emails. Without SMTP, development
# reset links are printed to the server console. Production returns 503.
# SMTP_URL=smtps://username:password@mail.example.com:465
# MAIL_FROM=PuzzleMind <hello@example.com>
